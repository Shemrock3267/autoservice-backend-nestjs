<!DOCTYPE html>
<html>
<head>
  <title>Reset Password</title>
</head>
<body>
<table style="width: 100%; height: 50px;">
  <tr>
    <td style="text-align: center; vertical-align: middle; padding-bottom: 20px; padding-top: 20px;">
      <img src="{{logo}}" alt="Logo" style="width: 157px; height: 18px;">
    </td>
  </tr>
</table>
<h1>Hi, {{firstname}} {{lastname}}!</h1>
<p>Click this button to reset your password</p>
<a href="{{redirectURL}}?token={{code}}" target="_blank" style="display: inline-block; padding: 10px 20px; background-color: #1976d2; color: #fff; text-decoration: none; border-radius: 10px; margin-top: 10px;">Reset password</a>
</body>
</html>
