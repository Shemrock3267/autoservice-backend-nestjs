<!DOCTYPE html>
<html lang="en">
<head>
  <title>Welcome Email</title>
</head>
<body>
<table style="width: 100%; height: 50px;">
  <tr>
    <td style="text-align: center; vertical-align: middle; padding-bottom: 20px; padding-top: 20px;">
      <img src="{{logo}}" alt="Logo" style="width: 157px; height: 18px;">
    </td>
  </tr>
</table>
<h1>Welcome, {{firstname}} {{lastname}}!</h1>
